# Required: shared secret for the admin page and for approving MCP clients (24+ chars).
MCP_SECRET=
# The only addresses the server will ever send to (To, Cc and Bcc). Empty disables sending.
ALLOWED_RECIPIENTS=zach@hackclub.com,zach@zachlatta.com
# Mailbox the server controls. Connecting any other Google account is refused.
MAILBOX_ADDRESS=zrl-bot@hackclub.com
# Public origin (https required off loopback).
PUBLIC_URL=http://127.0.0.1:8080
ADDR=127.0.0.1:8080
DATA_DIR=data
# Google OAuth client JSON (raw or base64). Desktop ("installed") or web client.
GOOGLE_OAUTH_CLIENT_JSON=
